#!/usr/bin/env bash
# Fake `codex` for offline tests. Behaviour is chosen by a MODE:<x> token in
# the prompt (read from stdin), so parallel calls can behave differently.
#   ok (default) | reconnect | fail | empty | sleep:<sec> | kill | bg | otherid
# Arguments are checked as strictly as codex-cli 0.162.1 (e.g. resume rejects -s).
# Every invocation's argv is appended to $FAKE_ARGS_LOG.
set -uo pipefail
args=("$@")
printf '%s\n' "${args[*]}" >> "${FAKE_ARGS_LOG:-/dev/null}"

[[ "${1:-}" == "exec" ]] || { echo "fake codex: only 'exec' is supported" >&2; exit 2; }
shift
tid="" out="" is_resume=0
if [[ "${1:-}" == "resume" ]]; then is_resume=1; tid="$2"; shift 2; fi
while (($#)); do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -m|-c) shift 2 ;;
    -s) ((is_resume == 0)) || { echo "fake codex: resume does not accept -s" >&2; exit 2; }; shift 2 ;;
    --json|--skip-git-repo-check|-) shift ;;
    *) echo "fake codex: unexpected argument: $1" >&2; exit 2 ;;
  esac
done
[[ -n "$out" ]] || { echo "fake codex: -o is required by the wrapper" >&2; exit 2; }
[[ -n "$tid" ]] || tid="$(cat /proc/sys/kernel/random/uuid)"
prompt="$(cat)"
mode="ok"; [[ "$prompt" =~ MODE:([a-z]+(:[0-9]+)?) ]] && mode="${BASH_REMATCH[1]}"
[[ "$mode" == "otherid" ]] && tid="$(cat /proc/sys/kernel/random/uuid)"

echo "{\"type\":\"thread.started\",\"thread_id\":\"$tid\"}"
echo '{"type":"turn.started"}'
case "$mode" in
  reconnect) echo '{"type":"error","message":"Reconnecting... 1/5 (stream disconnected before completion)"}' ;;
  fail) echo '{"type":"turn.failed","error":{"message":"simulated model failure"}}'; exit 1 ;;
  kill) kill -9 $$ ;;
  sleep:*) sleep "${mode#sleep:}" ;;
  bg) ( sleep 20 ) & ;;  # a straggler child that inherits our fds
esac
if [[ "$mode" != "empty" ]]; then
  printf 'reply from %s: %s' "$tid" "$prompt" > "$out"
else
  : > "$out"
fi
echo '{"type":"item.completed","item":{"type":"agent_message","text":"done"}}'
echo '{"type":"turn.completed","usage":{"input_tokens":1,"cached_input_tokens":0,"output_tokens":1,"reasoning_output_tokens":0}}'
